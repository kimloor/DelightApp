{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delightapp-d1-api",
  "main": "src/d1-api.js",
  "compatibility_date": "2026-07-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Replace after the D1 database is created with:
  // npx wrangler d1 create delightapp-db --location apac
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delightapp-db",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],

  // Non-secret staging value. For production, set the exact frontend origin.
  "vars": {
    "ALLOWED_ORIGIN": "*"
  }
}
