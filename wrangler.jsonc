{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delightapp",
  "main": "src/d1-api.js",
  "compatibility_date": "2026-07-20",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "หอพัก",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delightapp-db",
      "database_id": "<D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "*"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
